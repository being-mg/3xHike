# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_SERVICE_ACCOUNT_EMAIL: Email of the Google Service Account (e.g. your-account@your-project.iam.gserviceaccount.com)
GOOGLE_SERVICE_ACCOUNT_EMAIL=""

# GOOGLE_PRIVATE_KEY: The private key for the Google Service Account (e.g. "-----BEGIN PRIVATE KEY-----\nMIIEvgIB...-----END PRIVATE KEY-----\n")
GOOGLE_PRIVATE_KEY=""

# GOOGLE_SHEET_ID: The ID of the Google Sheet you want to append data to (found in the URL of the sheet)
# Note: You must share this sheet with the GOOGLE_SERVICE_ACCOUNT_EMAIL with "Editor" access.
GOOGLE_SHEET_ID=""
